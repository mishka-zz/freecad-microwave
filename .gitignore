__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.cache/
.hypothesis/
.idea/
.vscode/
*.swp
*.swo

# FreeCAD backup files, written beside any document it saves over
*.FCBak

# Solver working directories, written beside the document being simulated
*_sim/

# Touchstone exports. The save dialog opens beside the document, so these land
# in examples/ by default - and they are a solve's output, regenerated by any
# run, read by nothing here.
*.s[0-9]p
*.s[0-9][0-9]p
.DS_Store

# The example document belongs in examples/ and nowhere else. The builder
# writes beside itself; this is the second lock on the same door, so that a
# stray copy at the root cannot reach a `git add -A`.
/microstrip_50ohm.FCStd

# What the corpus probe writes when no destination is given. It is rewritten
# from the CAD kernel on every run, and is megabytes of triangles.
tests/_corpus/

# An environment or a build put inside the checkout. These carry other people's
# Python and other people's prose, held to none of the conventions here, and the
# tests that police the tree read the working tree rather than the index - so
# what is in the directory and is not ours has to be named somewhere, and this
# is where. `.git/info/exclude` is the same door for a file that is only yours.
.venv/
venv/
.direnv/
build/
dist/
.eggs/
*.egg-info/
